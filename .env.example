PORT=3001

# OpenSCAD generation provider: gemini (original) or lk-gemini
OPENSCAD_PROVIDER=gemini

# Original Google Gemini request (kept as the default)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# 如果在国内直连官方 API 超时，请配置本地代理，或者替换 GEMINI_URL 为你的国内代理中转地址
# HTTPS_PROXY=http://127.0.0.1:7890
# GEMINI_URL=https://your-proxy-domain.com/v1beta/models/gemini-1.5-pro:generateContent?key=your_gemini_api_key

# Gemini 3.1 Pro (lk888.ai Gemini-compatible generateContent API)
# OPENSCAD_PROVIDER=lk-gemini
# LK_GEMINI_API_KEY=your_lk888_api_key
# LK_GEMINI_MODEL=gemini-3.1-pro-preview
# LK_GEMINI_BASE_URL=https://api.lk888.ai
# lk888 Gemini requests bypass HTTP_PROXY/HTTPS_PROXY and connect directly.
# Optional: override the complete endpoint instead of BASE_URL + MODEL
# LK_GEMINI_URL=https://api.lk888.ai/v1beta/models/gemini-3.1-pro-preview:generateContent
